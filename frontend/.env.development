# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# INTERNAL_API_URL=http://gateway-dev:8080


# Esta es la que usa el browser (Client Side)
# DEBE ser la URL de ngrok porque el browser le pega desde "afuera"
NEXT_PUBLIC_API_URL=https://leana-hypersophisticated-scarlett.ngrok-free.dev/api

# Esta la usa Next.js si hacés Server Side Rendering (Server Side)
# Se queda igual porque dentro de la red de Docker el frontend ve al gateway como "gateway-dev"
INTERNAL_API_URL=http://gateway-dev:8080